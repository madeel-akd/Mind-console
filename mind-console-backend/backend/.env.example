# Copy this file to .env for local dev. On Railway, set these as Variables instead.

# MongoDB Atlas connection string (see README setup steps)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mind-console

# Long random string - used to sign login tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Your login credentials (this is a single-user personal system)
ADMIN_USERNAME=adeel
# Generate a bcrypt hash for your password with:
# node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# Anthropic API key - used only by the /api/summary endpoint. Get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Your deployed frontend origin, e.g. https://mind-console.pages.dev
# Used to lock down CORS so only your frontend can call this API
FRONTEND_ORIGIN=http://localhost:8080

PORT=3000
